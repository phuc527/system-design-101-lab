# Used by `npm run dev` (scripts/dev-local.ts) and by the Docker containers.
# Copy to .env if you want to keep your own values: cp .env.example .env

# ---------- API instance (src/api) ----------
PORT=3000
# Name returned in every response so you can see which instance answered
INSTANCE_NAME=api-local

# ---------- TypeScript load balancer (src/lb) ----------
LB_PORT=8091
# Comma-separated backend URLs
BACKENDS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# round-robin | least-connections | ip-hash | random
LB_STRATEGY=round-robin
# Active health checks
HEALTH_CHECK_INTERVAL_MS=2000
HEALTH_CHECK_TIMEOUT_MS=1000
# consecutive failures before a backend is marked DOWN / successes before UP again
UNHEALTHY_THRESHOLD=2
HEALTHY_THRESHOLD=2
# How long the LB waits for a backend to respond before giving up
PROXY_TIMEOUT_MS=5000

# ---------- Nginx (docker-compose only) ----------
# round-robin | least-conn | ip-hash | weighted | hash
NGINX_STRATEGY=round-robin
