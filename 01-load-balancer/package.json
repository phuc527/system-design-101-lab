{
  "name": "sd101-01-load-balancer",
  "version": "1.0.0",
  "description": "System Design 101 - Lab 01: load balancing with Nginx and a hand-written TypeScript load balancer",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:lb": "tsx watch src/lb/server.ts",
    "dev": "tsx scripts/dev-local.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:lb": "node dist/lb/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "dist": "tsx scripts/distribution.ts"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
