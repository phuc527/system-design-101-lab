# Copy to .env and adjust:  cp .env.example .env

# Port the HTTP server listens on
PORT=3000

# Human-friendly name returned in every response, so you can tell instances apart
INSTANCE_NAME=local

# Number of Node.js processes to run (cluster mode).
#   1    = single process, single event loop (default)
#   2..N = one primary + N worker processes sharing the same port
#   0    = one worker per CPU core
WORKERS=1

# Chaos settings applied to /api/* routes at startup (can be changed at runtime via POST /chaos)
#   CHAOS_FAILURE_RATE: 0.0 - 1.0  (0.2 = 20% of requests return HTTP 500)
#   CHAOS_EXTRA_LATENCY_MS: added delay for every /api/* request
CHAOS_FAILURE_RATE=0
CHAOS_EXTRA_LATENCY_MS=0

# Upper bounds so a typo cannot freeze your laptop
MAX_CPU_N=42
MAX_PAYLOAD_KB=10240
