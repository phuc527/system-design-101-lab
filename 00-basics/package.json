{
  "name": "sd101-00-basics",
  "version": "1.0.0",
  "description": "System Design 101 - Lab 00: latency, throughput, bandwidth, availability, scalability, reliability, fault tolerance, CAP",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "probe": "tsx scripts/probe.ts",
    "bench:io": "autocannon -c 100 -d 15 http://localhost:3000/api/io?ms=100",
    "bench:cpu": "autocannon -c 20 -d 15 http://localhost:3000/api/cpu?n=30"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
